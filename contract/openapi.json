{
  "components": {
    "schemas": {
      "CalculationRequest": {
        "description": "Arithmetic operation request",
        "properties": {
          "operands": {
            "description": "Operands as JSON numbers; the count depends on the operation: 1 for `sqrt`, 2 for the rest",
            "example": [
              1,
              3
            ],
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "operation": {
            "description": "Lowercase operation code",
            "enum": [
              "add",
              "subtract",
              "multiply",
              "divide",
              "power",
              "sqrt",
              "percentage"
            ],
            "example": "divide",
            "type": "string"
          }
        },
        "required": [
          "operands",
          "operation"
        ],
        "type": "object"
      },
      "CalculationResponse": {
        "description": "Arithmetic operation result",
        "properties": {
          "operation": {
            "description": "Operation that was performed",
            "enum": [
              "add",
              "subtract",
              "multiply",
              "divide",
              "power",
              "sqrt",
              "percentage"
            ],
            "example": "divide",
            "type": "string"
          },
          "result": {
            "description": "Plain decimal string, no exponent or trailing zeros",
            "example": "0.3333333333",
            "type": "string"
          }
        },
        "type": "object"
      },
      "ProblemDetail": {
        "properties": {
          "detail": {
            "type": "string"
          },
          "instance": {
            "format": "uri",
            "type": "string"
          },
          "properties": {
            "additionalProperties": {},
            "type": "object"
          },
          "status": {
            "format": "int32",
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "format": "uri",
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Arithmetic operations (add, subtract, multiply, divide, power, sqrt, percentage) over exact decimals (BigDecimal). Errors follow RFC 9457 ProblemDetail.",
    "title": "Sezzle Calculator API",
    "version": "v1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/calculate": {
      "post": {
        "operationId": "calculate",
        "requestBody": {
          "content": {
            "application/json": {
              "examples": {
                "divide": {
                  "description": "divide",
                  "value": {
                    "operands": [
                      1,
                      3
                    ],
                    "operation": "divide"
                  }
                },
                "percentage": {
                  "description": "percentage",
                  "value": {
                    "operands": [
                      20,
                      150
                    ],
                    "operation": "percentage"
                  }
                },
                "sqrt": {
                  "description": "sqrt",
                  "value": {
                    "operands": [
                      2
                    ],
                    "operation": "sqrt"
                  }
                }
              },
              "schema": {
                "$ref": "#/components/schemas/CalculationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "examples": {
                  "divide": {
                    "description": "divide",
                    "value": {
                      "operation": "divide",
                      "result": "0.3333333333"
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/CalculationResponse"
                }
              }
            },
            "description": "Operation result"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Malformed request, unsupported operation, invalid operand count, operand out of range, invalid operand, result out of range or division by zero"
          }
        },
        "summary": "Perform an arithmetic operation",
        "tags": [
          "Calculator"
        ]
      }
    }
  }
}
