# Host ports (8080 and 5173 are avoided on purpose: commonly taken by other local containers)
# `make up` (scripts/up.sh) moves to the next free port when one of these is taken.
BACKEND_JAVA_PORT=8090
BACKEND_GO_PORT=8091
WEB_PORT=3000
VITE_PORT=5180
# Vite dev proxy targets (/api/java/… and /api/go/…)
VITE_JAVA_TARGET=http://localhost:8090
VITE_GO_TARGET=http://localhost:8091
# Deprecated aliases, still accepted: BACKEND_PORT (= BACKEND_JAVA_PORT) and
# VITE_API_PROXY_TARGET (= VITE_JAVA_TARGET). The new names win when both are set.
